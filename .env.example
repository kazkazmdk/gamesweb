# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Gamesweb

# Backend: auto | memory | supabase
# auto = Supabase when configured, otherwise in-process memory (never in Vercel production)
GAMESWEB_BACKEND=auto

# Supabase — publishable key is safe in the browser. Secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias still accepted:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the client.
SUPABASE_SECRET_KEY=
# Alias still accepted:
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis REST — required in Vercel production for auth/score/merge/friends rate limits.
# Memory fallback is only for local development and CI.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional; magic-link abuse protection)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Show clearly-marked seed rivals (ignored when VERCEL_ENV=production)
NEXT_PUBLIC_SHOW_SEED_DATA=false
