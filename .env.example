# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Gamesweb

# Supabase (optional — app runs in local-first guest mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (optional — analytics adapter no-ops without a key)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Show clearly-marked seed rivals on leaderboards (never in production)
NEXT_PUBLIC_SHOW_SEED_DATA=false
